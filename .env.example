# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env n'est JAMAIS commité (voir .gitignore).

# Clé créée sur https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Utilisateur Last.fm affiché par défaut
LASTFM_USER=

# Prénom affiché sur le mur de LASTFM_USER (optionnel)
DISPLAY_NAME=

# Durée de vie du cache serveur, en secondes
CACHE_TTL_SECONDS=60

# true = données d'exemple, sans appeler Last.fm (utile sans clé)
DEMO_MODE=false

PORT=3000
